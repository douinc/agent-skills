{
  "version": "0.1-synthetic-seed",
  "note": "합성 시드 사전. 연구(번역투/GPT체/LLM 한국어 언어학적 시그니처) + 전형 사례 기반으로 작성됨. 실제 파이프라인 실패 사례가 쌓이면 검증·확장할 것. severity: error=거의 항상 부자연, warn=맥락 검토 필요. register: all | casual(앱 카피·요약·알림) | formal(문서·이메일).",
  "patterns": [
    {"id": "T01", "category": "번역투", "type": "match", "regex": "에 대해서?[ ,]|에 대한 ", "severity": "warn", "register": "all", "message": "'~에 대해/대한'(about 직역) 남용", "fix": "목적어로 직접 받거나 문장 재구성: '레시피에 대해 소개한다' → '레시피를 소개한다'"},
    {"id": "T02", "category": "번역투", "type": "match", "regex": "[을를] 통해", "severity": "warn", "register": "all", "message": "'~를 통해'(through 직역)", "fix": "'~로', '~에서', '~하며'로 교체"},
    {"id": "T03", "category": "번역투", "type": "match", "regex": "에 있어서?[ ,]", "severity": "error", "register": "all", "message": "'~에 있어'(일본어투 において)", "fix": "'~에서', '~할 때', 조사 '~의'로 교체"},
    {"id": "T04", "category": "번역투", "type": "match", "regex": "[으로]로 인해|[으로]로 인한", "severity": "warn", "register": "all", "message": "'~로 인해'(due to 직역)", "fix": "'~때문에', '~로' 교체"},
    {"id": "T05", "category": "번역투", "type": "match", "regex": "에 의해서?[ ,]|에 의한 ", "severity": "error", "register": "all", "message": "'~에 의해' 피동(by 직역)", "fix": "능동문으로 전환: '팀에 의해 개발되었다' → '팀이 개발했다'"},
    {"id": "T06", "category": "번역투", "type": "match", "regex": "보여지|되어지|쓰여지|불려지|믿겨지|잊혀지|담겨지|모아지|읽혀지", "severity": "error", "register": "all", "message": "이중피동", "fix": "단일 피동 또는 능동: '보여진다' → '보인다', '되어진다' → '된다'"},
    {"id": "T07", "category": "번역투", "type": "match", "regex": "당신의 |그녀의 |그의 ", "severity": "warn", "register": "all", "message": "소유격 대명사 남용(영어식)", "fix": "한국어는 소유격 생략이 기본. 삭제하거나 문맥으로 처리"},
    {"id": "T08", "category": "번역투", "type": "match", "regex": "것[을이] 가능하게|하는 것이 가능", "severity": "error", "register": "all", "message": "'~하는 것을 가능하게 하다'(enable 직역)", "fix": "'~할 수 있게 하다', '~하게 해 준다'"},
    {"id": "T09", "category": "번역투", "type": "match", "regex": "(의미|중요성|특징|장점|효과|가치)[를을] (가지|갖)", "severity": "error", "register": "all", "message": "'~을 가지다'(have 직역)", "fix": "'~이/가 있다': '의미를 가진다' → '의미가 있다'"},
    {"id": "T10", "category": "번역투", "type": "match", "regex": "에 위치하[고는여한]", "severity": "warn", "register": "all", "message": "'~에 위치하다'(located in 직역)", "fix": "'~에 있다'"},
    {"id": "T11", "category": "번역투", "type": "match", "regex": "가장 [가-힣]{1,6} (중|것 중) 하나", "severity": "warn", "register": "all", "message": "'가장 ~한 것 중 하나'(one of the most 직역)", "fix": "단정하거나 '손꼽히는', '대표적인'으로"},
    {"id": "T12", "category": "번역투", "type": "match", "regex": "(검토|분석|개선|논의|테스트|개발|작업|확인|점검|조사)[를을] (진행|수행|실시)[하해한했]", "severity": "error", "register": "all", "message": "명사+진행/수행 (동사의 명사화)", "fix": "동사로 직접: '검토를 진행한다' → '검토한다'"},
    {"id": "T13", "category": "번역투", "type": "match", "regex": "[을를] 필요로 하", "severity": "error", "register": "all", "message": "'~을 필요로 하다'(require 직역)", "fix": "'~이/가 필요하다'"},
    {"id": "T14", "category": "번역투", "type": "match", "regex": "[이가] 존재(한다|합니다|해요|하며|하고)", "severity": "warn", "register": "all", "message": "'존재하다'(exist 직역) 남용", "fix": "'있다'"},
    {"id": "T15", "category": "번역투", "type": "frequency", "regex": "[가-힣]들[이을은의과에 ,.]", "max_per_1000": 6, "severity": "warn", "register": "all", "message": "복수 접미사 '-들' 남발(영어 복수형 직역)", "fix": "한국어는 복수 표지 생략이 자연스러움. 문맥상 필요한 곳만 남기기"},
    {"id": "G01", "category": "GPT체", "type": "match", "regex": "^물론(입니다|이죠|이에요)|물론입니다[.!]", "severity": "error", "register": "all", "message": "'물론입니다' 어시스턴트 상투 서두", "fix": "삭제하고 본론부터"},
    {"id": "G02", "category": "GPT체", "type": "match", "regex": "중요한 역할을 [하합해했]", "severity": "error", "register": "all", "message": "'중요한 역할을 합니다' 상투구", "fix": "무엇을 어떻게 하는지 구체적으로 서술"},
    {"id": "G03", "category": "GPT체", "type": "frequency", "regex": "다양한", "max_per_1000": 2, "severity": "warn", "register": "all", "message": "'다양한' 남발", "fix": "구체적 수·종류로 대체하거나 삭제"},
    {"id": "G04", "category": "GPT체", "type": "frequency", "regex": "[할될] 수 있(습니다|어요|다)", "max_per_1000": 3, "severity": "warn", "register": "all", "message": "'~할 수 있습니다' 헤징 반복", "fix": "단정 가능한 것은 단정: '확인할 수 있습니다' → '확인됩니다/확인하세요'"},
    {"id": "G05", "category": "GPT체", "type": "frequency", "regex": "뿐만 아니라", "max_per_1000": 1, "severity": "warn", "register": "all", "message": "'뿐만 아니라' 남발(not only 직역)", "fix": "'~도', '게다가'로 단순화"},
    {"id": "G06", "category": "GPT체", "type": "match", "regex": "결론적으로|요약하자면|정리하자면|전반적으로", "severity": "warn", "register": "all", "message": "메타 담화(본문이 짧은데 요약 선언)", "fix": "제품 텍스트·짧은 글에서는 삭제"},
    {"id": "G07", "category": "GPT체", "type": "match", "regex": "필수적(입니다|이다|이에요|인)", "severity": "warn", "register": "all", "message": "'필수적'(essential 직역)", "fix": "'꼭 필요하다', '~해야 한다'"},
    {"id": "G08", "category": "GPT체", "type": "match", "regex": "도움이 되(었으면|길|시길) (좋겠습니다|바랍니다|합니다)", "severity": "error", "register": "all", "message": "어시스턴트 상투 결구", "fix": "삭제"},
    {"id": "G09", "category": "GPT체", "type": "match", "regex": "하시기 바랍니다", "severity": "warn", "register": "casual", "message": "과잉 격식(앱 카피 레지스터)", "fix": "'~해 주세요', '~하세요'"},
    {"id": "G10", "category": "GPT체", "type": "frequency", "regex": " 및 ", "max_per_1000": 2, "severity": "warn", "register": "casual", "message": "'및' 남발(문어투)", "fix": "'와/과', '그리고', 쉼표 나열"},
    {"id": "G11", "category": "GPT체", "type": "frequency", "regex": "해당 ", "max_per_1000": 2, "severity": "warn", "register": "all", "message": "'해당' 남발", "fix": "'그', '이' 또는 명사 직접 지칭"},
    {"id": "G12", "category": "GPT체", "type": "frequency", "regex": "[를을] 위해", "max_per_1000": 3, "severity": "warn", "register": "all", "message": "'~을 위해'(for 직역) 과다", "fix": "'~하려고', '~하도록', 어미 통합"},
    {"id": "G13", "category": "GPT체", "type": "match", "regex": "[\\u2728\\u2705\\u274c\\u26a0\\ud83c-\\ud83e]", "severity": "warn", "register": "all", "message": "이모지 포함(제품 텍스트 데이터에 부적합할 수 있음)", "fix": "텍스트 데이터·문서에서는 제거, 마케팅 카피만 선택적 허용"},
    {"id": "G14", "category": "GPT체", "type": "match", "regex": "\\*\\*[^*]+\\*\\*", "severity": "warn", "register": "casual", "message": "마크다운 볼드(제품 텍스트에 마크업 잔류)", "fix": "플레인 텍스트로"},
    {"id": "M01", "category": "형태", "type": "frequency", "regex": "(하며|하고|으며|지만|는데),", "max_per_1000": 3, "severity": "warn", "register": "all", "message": "연결어미 뒤 쉼표 남용(LLM 한국어 시그니처)", "fix": "쉼표 삭제 또는 문장 분리"},
    {"id": "M04", "category": "형태", "type": "frequency", "regex": "(^|\\. )(또한|그리고|하지만|그러나|더불어)[, ]", "max_per_1000": 2, "severity": "warn", "register": "all", "message": "접속부사 문두 반복", "fix": "접속부사 없이 문장 연결이 자연스러운지 확인"},
    {"id": "M05", "category": "형태", "type": "match", "regex": "하였다|하였습니다|되었다|되었습니다", "severity": "warn", "register": "casual", "message": "'하였다/되었다' 축약 미적용(앱 카피 레지스터)", "fix": "'했다/됐다' — 문서·보고서에서는 허용"},
    {"id": "L01", "category": "어휘", "type": "match", "regex": "수령[하해한할]", "severity": "error", "register": "casual", "message": "'수령하다'", "fix": "'받다'"},
    {"id": "L02", "category": "어휘", "type": "match", "regex": "금일|익일|명일", "severity": "error", "register": "casual", "message": "관공서투 날짜 표현", "fix": "'오늘', '다음 날', '내일'"},
    {"id": "L03", "category": "어휘", "type": "match", "regex": "상이하[다고며여]", "severity": "error", "register": "casual", "message": "'상이하다'", "fix": "'다르다'"},
    {"id": "L04", "category": "어휘", "type": "match", "regex": "용이하[다고며여]", "severity": "error", "register": "casual", "message": "'용이하다'", "fix": "'쉽다'"},
    {"id": "L05", "category": "어휘", "type": "match", "regex": "(상기|하기) (내용|사항|항목)", "severity": "warn", "register": "all", "message": "'상기/하기'(공문투)", "fix": "'위/아래 내용'"},
    {"id": "L06", "category": "어휘", "type": "match", "regex": "요망[.\\s]|요망$", "severity": "error", "register": "casual", "message": "'~요망'(공문투)", "fix": "'~해 주세요'"},
    {"id": "L07", "category": "어휘", "type": "match", "regex": "익월|차주", "severity": "warn", "register": "casual", "message": "'익월/차주'", "fix": "'다음 달', '다음 주'"},
    {"id": "L08", "category": "어휘", "type": "match", "regex": "활용하[여시][면어]?|활용해 보세요", "severity": "warn", "register": "casual", "message": "'활용하다' 남발", "fix": "'쓰다', '사용하다' 또는 구체 동사"},
    {"id": "E01", "category": "어휘-쉬움", "type": "match", "regex": "도출[하해한할되]", "severity": "error", "register": "easy", "message": "'도출하다' (easy 어휘 위반)", "fix": "'찾다', '뽑다', '얻다'"},
    {"id": "E02", "category": "어휘-쉬움", "type": "match", "regex": "수반[하되됩]", "severity": "error", "register": "easy", "message": "'수반하다' (easy 어휘 위반)", "fix": "'~이 따르다', '~도 함께 생기다'"},
    {"id": "E03", "category": "어휘-쉬움", "type": "match", "regex": "기재[하해된]", "severity": "error", "register": "easy", "message": "'기재하다' (easy 어휘 위반)", "fix": "'쓰다', '적다'"},
    {"id": "E04", "category": "어휘-쉬움", "type": "match", "regex": "소요(되|됩|시간)", "severity": "error", "register": "easy", "message": "'소요되다' (easy 어휘 위반)", "fix": "'걸리다'"},
    {"id": "E05", "category": "어휘-쉬움", "type": "match", "regex": "숙지[하해]", "severity": "error", "register": "easy", "message": "'숙지하다' (easy 어휘 위반)", "fix": "'잘 알아두다', '미리 읽어두다'"},
    {"id": "E06", "category": "어휘-쉬움", "type": "match", "regex": "취합[하해되]", "severity": "error", "register": "easy", "message": "'취합하다' (easy 어휘 위반)", "fix": "'모으다', '합치다'"},
    {"id": "E07", "category": "어휘-쉬움", "type": "match", "regex": "송부|회신 바랍니다", "severity": "error", "register": "easy", "message": "'송부/회신' (easy 어휘 위반)", "fix": "'보내다' / '답장 주세요'"},
    {"id": "E08", "category": "어휘-쉬움", "type": "match", "regex": "필히|유관 부서|제반 ", "severity": "error", "register": "easy", "message": "공문투 어휘 (easy 어휘 위반)", "fix": "'꼭' / '관련 부서' / '여러 가지'"}
  ]
}
