{
  "version": "0.2-proposed",
  "note": "합성 시드 사전. severity: error=거의 항상 부자연, warn=맥락 검토 필요. register: all | casual(앱 카피·요약·알림) | formal(문서·이메일) | easy(--lexicon easy일 때만). frequency 패턴은 min_count(기본 1) 이상 나오고 max_per_1000을 넘을 때만 지적. 모든 패턴은 tests.hit/miss 예문을 가진다 — 새 패턴도 예문과 함께 추가하고 lint.py --selftest로 확인.",
  "patterns": [
    {"id": "T01", "category": "번역투", "type": "match", "regex": "에 (?:대|관)(?:해|하여|한)(?!민국)", "severity": "warn", "register": "all", "message": "'~에 대해/대한/관해'(about 직역) 남용", "fix": "목적어로 직접 받거나 문장 재구성: '성능에 대해 비교했다' → '성능을 비교했다'", "tests": {"hit": ["성능에 대해 비교했다", "레시피에 대해 소개한다", "정책에 대한 의견", "이에 대하여 설명드립니다", "정산에 관해 안내드립니다"], "miss": ["세계에 대한민국을 알리다", "레시피를 소개한다"]}},
    {"id": "T02", "category": "번역투", "type": "match", "regex": "[을를] 통해", "severity": "warn", "register": "all", "message": "'~를 통해'(through 직역)", "fix": "'~로', '~에서', '~하며'로 교체", "tests": {"hit": ["앱을 통해 확인하세요", "메일을 통해서 보냈다"], "miss": ["앱에서 확인하세요"]}},
    {"id": "T03", "category": "번역투", "type": "match", "regex": "(?:는 데|함에) 있어(?:서)?(?:는|의)?(?=[ ,])", "severity": "error", "register": "all", "message": "'~하는 데 있어/~함에 있어'(일본어투 において)", "fix": "'~할 때', '~하려면'으로 교체: '개발함에 있어 고려할 점' → '개발할 때 고려할 점'", "tests": {"hit": ["개발함에 있어서 고려할 점", "운영하는 데 있어 필요한 것"], "miss": ["카드가 저장함에 있어요", "매장이 강남역 근처에 있어서 찾기 쉬워요"]}},
    {"id": "T04", "category": "번역투", "type": "match", "regex": "로 인(?:해|한|하여)", "severity": "warn", "register": "all", "message": "'~로 인해'(due to 직역)", "fix": "'~때문에', '~로' 교체", "tests": {"hit": ["내부 사정으로 인해 연기됐다", "이로 인해 불편을 드렸다", "네트워크 문제로 인한 지연", "오류로 인하여 실패했다"], "miss": ["인해전술", "문제 때문에 늦어졌다"]}},
    {"id": "T05", "category": "번역투", "type": "match", "regex": "에 의(?:해서?|하여|한)(?=[\\s,])", "severity": "error", "register": "all", "message": "'~에 의해' 피동(by 직역)", "fix": "능동문으로 전환: '팀에 의해 개발되었다' → '팀이 개발했다'", "tests": {"hit": ["팀에 의해 개발되었다", "사용자에 의한 변경", "법에 의하여 보호된다"], "miss": ["보도에 의하면 내일 발표한다", "팀이 개발했다"]}},
    {"id": "T06", "category": "번역투", "type": "match", "regex": "(?:보여|되어|쓰여|불려|믿겨|잊혀|담겨|모아|읽혀|나뉘어|짜여|놓여|쌓여|열려|닫혀|잡혀|바뀌어)(?:지|진|져|집|짐)", "severity": "error", "register": "all", "message": "이중피동", "fix": "단일 피동 또는 능동: '보여진다' → '보인다', '되어진다' → '된다'", "tests": {"hit": ["화면에 보여지는 값", "화면에 보여진다", "개발되어진 기능", "잘 쓰여진 글", "보여져서", "세 단계로 나뉘어진다", "문이 열려지고"], "miss": ["만들어진 기능", "주어진 시간", "이루어진다", "알려진 문제"]}},
    {"id": "T07", "category": "번역투", "type": "match", "regex": "당신(?:의|은|이|을|에게) |그녀의 |그의 ", "severity": "warn", "register": "all", "message": "2인칭·소유격 대명사 남용(영어식)", "fix": "한국어는 소유격 생략이 기본. 삭제하거나 문맥으로 처리", "tests": {"hit": ["당신의 저장함에서", "당신을 위한 추천", "그녀의 레시피"], "miss": ["저장함에서 찾아보세요"]}},
    {"id": "T08", "category": "번역투", "type": "match", "regex": "것[을이] 가능하게|하는 것이 가능", "severity": "error", "register": "all", "message": "'~하는 것을 가능하게 하다'(enable 직역)", "fix": "동사를 바로 쓴다: '검색하는 것을 가능하게 한다' → '검색해 준다'. '~할 수 있게 한다'도 enable 직역에 가까우니 남발하지 않는다", "tests": {"hit": ["검색하는 것을 가능하게 한다", "저장하는 것이 가능합니다"], "miss": ["검색해 준다"]}},
    {"id": "T09", "category": "번역투", "type": "match", "regex": "(?:의미|중요성|특징|장점|효과|가치)[를을] (?:가지|가진|가집|가져|갖)", "severity": "error", "register": "all", "message": "'~을 가지다'(have 직역)", "fix": "'~이/가 있다': '의미를 가진다' → '의미가 있다'", "tests": {"hit": ["큰 의미를 가진다", "큰 의미를 가집니다", "의미를 가져요", "장점을 갖는다"], "miss": ["큰 의미가 있다"]}},
    {"id": "T10", "category": "번역투", "type": "match", "regex": "에 위치(?:하|해|한|할|합|했)", "severity": "warn", "register": "all", "message": "'~에 위치하다'(located in 직역)", "fix": "'~에 있다'", "tests": {"hit": ["강남역에 위치한 카페", "1층에 위치해 있습니다", "1층에 위치합니다"], "miss": ["강남역에 있는 카페"]}},
    {"id": "T11", "category": "번역투", "type": "match", "regex": "가장 [가-힣]+(?: [가-힣]+){0,2} (?:것 )?중 하나", "severity": "warn", "register": "all", "message": "'가장 ~한 것 중 하나'(one of the most 직역)", "fix": "단정하거나 '손꼽히는', '대표적인'으로", "tests": {"hit": ["가장 인기 있는 것 중 하나", "가장 빠른 도구 중 하나"], "miss": ["손꼽히는 도구"]}},
    {"id": "T12", "category": "번역투", "type": "match", "regex": "(?:검토|분석|개선|논의|테스트|개발|작업|확인|점검|조사|업데이트|배포|설치|수정|검증|평가)[를을] (?:진행|수행|실시)(?:하|해|한|할|합|했)", "severity": "error", "register": "all", "message": "명사+진행/수행 (동사의 명사화)", "fix": "동사로 직접: '검토를 진행한다' → '검토한다'", "tests": {"hit": ["검토를 진행했습니다", "분석을 수행한다", "분석을 수행합니다", "업데이트를 진행합니다"], "miss": ["회의를 진행했습니다", "검토했습니다"]}},
    {"id": "T13", "category": "번역투", "type": "match", "regex": "[을를] 필요로 (?:하|해|한|할|합|했)", "severity": "error", "register": "all", "message": "'~을 필요로 하다'(require 직역)", "fix": "'~이/가 필요하다'", "tests": {"hit": ["많은 시간을 필요로 한다", "시간을 필요로 합니다", "시간을 필요로 하는"], "miss": ["시간이 많이 필요하다"]}},
    {"id": "T14", "category": "번역투", "type": "match", "regex": "[이가] 존재(한다|합니다|해요|하며|하고)", "severity": "warn", "register": "all", "message": "'존재하다'(exist 직역) 남용", "fix": "'있다'", "tests": {"hit": ["문제가 존재합니다", "버그가 존재하며"], "miss": ["문제가 있습니다"]}},
    {"id": "T15", "category": "번역투", "type": "frequency", "regex": "[가-힣]들(?:[이을은의과에도로만]|에게|까지|[ ,.])", "max_per_1000": 6, "severity": "warn", "register": "all", "message": "복수 접미사 '-들' 남발(영어 복수형 직역)", "fix": "한국어는 복수 표지 생략이 자연스러움. 문맥상 필요한 곳만 남기기", "min_count": 2, "tests": {"hit": ["재료들과 팁들을 담았다"], "miss": ["재료와 팁을 담았다", "친구들이 좋아해요"]}},
    {"id": "G01", "category": "GPT체", "type": "match", "regex": "^(?:물론(?:입니다|이죠|이에요)|좋은 질문(?:입니다|이에요|이네요))|물론입니다[.!]", "severity": "error", "register": "all", "message": "'물론입니다' 어시스턴트 상투 서두", "fix": "삭제하고 본론부터", "tests": {"hit": ["물론입니다! 정리해 드릴게요", "좋은 질문입니다. 먼저"], "miss": ["정리해 드릴게요"]}},
    {"id": "G02", "category": "GPT체", "type": "match", "regex": "(?:중요한|핵심적인|결정적인|중추적인) 역할을 (?:하|해|한|할|합|했|담당)", "severity": "error", "register": "all", "message": "'중요한 역할을 합니다' 상투구", "fix": "무엇을 어떻게 하는지 구체적으로 서술", "tests": {"hit": ["중요한 역할을 합니다", "중요한 역할을 한다", "핵심적인 역할을 담당한다"], "miss": ["재방문을 이끈다"]}},
    {"id": "G03", "category": "GPT체", "type": "frequency", "regex": "다양한", "max_per_1000": 2, "severity": "warn", "register": "all", "message": "'다양한' 남발", "fix": "구체적 수·종류로 대체하거나 삭제", "tests": {"hit": ["다양한 기능을 제공합니다"], "miss": ["기능 세 가지를 제공합니다"]}},
    {"id": "G04", "category": "GPT체", "type": "frequency", "regex": "[가-힣] 수 있(?:습니다|어요|다|는|을|으며|고)", "max_per_1000": 3, "severity": "warn", "register": "all", "message": "'~(할/볼/받을) 수 있습니다' 헤징 반복", "fix": "단정 가능한 것은 단정: '확인할 수 있습니다' → '확인됩니다/확인하세요'", "min_count": 2, "tests": {"hit": ["확인할 수 있습니다. 결과를 볼 수 있어요. 혜택을 받을 수 있습니다"], "miss": ["지금 확인할 수 있어요", "지금 확인하세요"]}},
    {"id": "G05", "category": "GPT체", "type": "frequency", "regex": "뿐만 아니라", "max_per_1000": 1, "severity": "warn", "register": "all", "message": "'뿐만 아니라' 남발(not only 직역)", "fix": "'~도', '게다가'로 단순화", "tests": {"hit": ["속도뿐만 아니라 품질도"], "miss": ["속도도 품질도"]}},
    {"id": "G06", "category": "GPT체", "type": "match", "regex": "결론적으로|요약하자면|정리하자면|전반적으로", "severity": "warn", "register": "all", "message": "메타 담화(본문이 짧은데 요약 선언)", "fix": "제품 텍스트·짧은 글에서는 삭제", "tests": {"hit": ["결론적으로 이 방식이 낫다", "요약하자면 세 가지다"], "miss": ["이 방식이 낫다"]}},
    {"id": "G07", "category": "GPT체", "type": "match", "regex": "필수적(입니다|이다|이에요|인)", "severity": "warn", "register": "all", "message": "'필수적'(essential 직역)", "fix": "'꼭 필요하다', '~해야 한다'", "tests": {"hit": ["백업은 필수적입니다", "필수적인 기능"], "miss": ["백업은 꼭 해야 합니다"]}},
    {"id": "G08", "category": "GPT체", "type": "match", "regex": "도움이 (?:되|돼|됐)[가-힣]*\\s+(?:바랍니다|바라요|바라며|좋겠습니다|좋겠어요|합니다)", "severity": "error", "register": "all", "message": "어시스턴트 상투 결구", "fix": "삭제", "tests": {"hit": ["본 메일이 도움이 되었기를 바랍니다", "도움이 되셨길 바랍니다", "도움이 되셨으면 좋겠습니다", "도움이 되길 바랍니다", "도움이 됐으면 좋겠어요"], "miss": ["도움이 되는 정보입니다", "큰 도움이 됐어요"]}},
    {"id": "G09", "category": "GPT체", "type": "match", "regex": "하시기 바랍니다", "severity": "warn", "register": "casual", "message": "과잉 격식(앱 카피 레지스터)", "fix": "'~해 주세요', '~하세요'", "tests": {"hit": ["지금 확인하시기 바랍니다"], "miss": ["지금 확인해 주세요"]}},
    {"id": "G10", "category": "GPT체", "type": "frequency", "regex": " 및 ", "max_per_1000": 2, "severity": "warn", "register": "casual", "message": "'및' 남발(문어투)", "fix": "'와/과', '그리고', 쉼표 나열", "tests": {"hit": ["저장 및 공유"], "miss": ["저장과 공유"]}},
    {"id": "G11", "category": "GPT체", "type": "frequency", "regex": "해당 ", "max_per_1000": 2, "severity": "warn", "register": "all", "message": "'해당' 남발", "fix": "'그', '이' 또는 명사 직접 지칭", "tests": {"hit": ["해당 장소의 영업시간"], "miss": ["이 장소의 영업시간"]}},
    {"id": "G12", "category": "GPT체", "type": "frequency", "regex": "[를을] 위해", "max_per_1000": 3, "severity": "warn", "register": "all", "message": "'~을 위해'(for 직역) 과다", "fix": "'~하려고', '~하도록', 어미 통합", "min_count": 2, "tests": {"hit": ["성장을 위해 투자하고 재방문을 위해 알림을 보냈다"], "miss": ["재방문을 늘리려고 알림을 보냈다"]}},
    {"id": "G13", "category": "GPT체", "type": "match", "regex": "[\\u2600-\\u27BF\\U0001F300-\\U0001FAFF]", "severity": "warn", "register": "all", "message": "이모지 포함(제품 텍스트 데이터에 부적합할 수 있음)", "fix": "텍스트 데이터·문서에서는 제거, 마케팅 카피만 선택적 허용", "tests": {"hit": ["새 기능이 나왔어요 🎉", "출시 완료 🚀", "완료 ✅", "주의 ⚠"], "miss": ["새 기능이 나왔어요 →"]}},
    {"id": "G14", "category": "GPT체", "type": "match", "regex": "\\*\\*[^*]+\\*\\*", "severity": "warn", "register": "casual", "message": "마크다운 볼드(제품 텍스트에 마크업 잔류)", "fix": "플레인 텍스트로", "tests": {"hit": ["**중요** 공지"], "miss": ["중요 공지"]}},
    {"id": "M01", "category": "형태", "type": "frequency", "regex": "(?:하며|하고|으며|이며|되며|지만|는데|면서),", "max_per_1000": 3, "severity": "warn", "register": "all", "message": "연결어미 뒤 쉼표 남용(LLM 한국어 시그니처)", "fix": "쉼표 삭제 또는 문장 분리", "min_count": 2, "tests": {"hit": ["설명하며, 비교하고, 정리했다"], "miss": ["설명하며 비교하고 정리했다"]}},
    {"id": "M04", "category": "형태", "type": "frequency", "regex": "(^|\\. )(또한|그리고|하지만|그러나|더불어)[, ]", "max_per_1000": 2, "severity": "warn", "register": "all", "message": "접속부사 문두 반복", "fix": "접속부사 없이 문장 연결이 자연스러운지 확인", "min_count": 2, "tests": {"hit": ["빠르다. 또한 가볍다. 또한 싸다."], "miss": ["빠르고 가볍고 싸다."]}},
    {"id": "M05", "category": "형태", "type": "match", "regex": "(?:하였|되었)(?:다|습니다|으며|고|는데|지만|으나)", "severity": "warn", "register": "casual", "message": "'하였다/되었다' 축약 미적용(앱 카피 레지스터)", "fix": "'했다/됐다' — 문서·보고서에서는 허용", "tests": {"hit": ["도착하였습니다", "개발되었으며 배포했다", "배포하였고 확인했다"], "miss": ["도착했어요", "배포했다"]}},
